#ifndef _RTFS_TIMER_H_
#define _RTFS_TIMER_H_

#include "queue_extras.h"

#include <stdint.h>
#include <sys/epoll.h>
#include <sys/timerfd.h>
#include <time.h>


typedef struct RtfsTimer
{
    int timerFd;
    struct timespec expirationTime;
    uint8_t isPeriod;
    uint8_t isBlockCheck; // rtfsTimerCheckExpire 时是否阻塞直到到期。
} RtfsTimer;

/* 定时器操作接口。 */

/* isBlockCheck：定时器是阻塞还是非阻塞。 */
int rtfsTimerConstructor(RtfsTimer *this, uint8_t isBlockCheck);
void rtfsTimerDestructor(RtfsTimer *this);
void rtfsTimerSet(RtfsTimer *this, struct timespec *expirationTime, uint8_t isPeriod);
int rtfsTimerStart(RtfsTimer *this);
int rtfsTimerStop(RtfsTimer *this);

/*
 * 检查定时器是否到期。
 * 若定时器设置了 isBlockCheck，则阻塞到到期后返回 0；若发生其它错误，返回 errno。
 * 若定时器未设置 isBlockCheck，直接返回：若到期，返回 0；若未到期，则返回 EAGAIN；若发生其它错误，返回 errno。
 * 若 overflowTimes 不为 NULL，则保存到期次数。
 */
int rtfsTimerCheckExpire(RtfsTimer *this, uint64_t *overflowTimes);


/* 定时器监听器，可同时监听多个定时器。 */

#define RTFS_TIMER_MONITOR_MAX_SIZE_PER_WAIT 16
#define RTFS_TIMER_MONITOR_ENTRY_LIST_ENTRY ListEntry
typedef void (*rtfsTimerCb)(uint64_t overflowTimes, void *arg);

typedef struct RtfsTimerMonitorEntry
{
    RtfsTimer *timer;
    rtfsTimerCb cbFunc;
    void *cbArg;

    LIST_ENTRY(RtfsTimerMonitorEntry)
    RTFS_TIMER_MONITOR_ENTRY_LIST_ENTRY;
} RtfsTimerMonitorEntry;

typedef struct RtfsTimerMonitor
{
    int epollFd;
    struct epoll_event evlist[RTFS_TIMER_MONITOR_MAX_SIZE_PER_WAIT];

    LIST_HEAD(, RtfsTimerMonitorEntry)
    MonitorEntryList;
} RtfsTimerMonitor;

/*
 * 定时器监控器操作接口。
 * 监控器不具备对定时器的所有权，将定时器加入监控器后，销毁监控器不会销毁对应定时器。
 */
int rtfsTimerMonitorConstructor(RtfsTimerMonitor *this);
void rtfsTimerMonitorDestructor(RtfsTimerMonitor *this);
int rtfsTimerMonitorAddTimer(RtfsTimerMonitor *this, RtfsTimer *timer, rtfsTimerCb cbFunc, void *cbArg);
int rtfsTimerMonitorDelTimer(RtfsTimerMonitor *this, RtfsTimer *timer);

/*
 * 等待已加入的定时器到期，该函数可能阻塞。
 * 返回已到期定时器个数，出错返回 -errno。
 */
int rtfsTimerMonitorWaitAddedTimer(RtfsTimerMonitor *this);


#endif
